<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wallet_bg_gray"
    tools:context=".Activity_Home_Page">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/wallet_blue"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtInicioHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inicio"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/jua"
        android:layout_margin="50dp"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtTituloSaludoHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Hola, Amanda!"
        android:textColor="@color/wallet_bg_gray"
        android:textSize="14sp"
        android:fontFamily="@font/jua"
        android:layout_marginStart="50dp"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/txtInicioHome"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/txtTituloBalanceHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Balance Total"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/jua"
        android:layout_marginStart="50dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloSaludoHome"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/txtMontoBalanceHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0,00"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:fontFamily="@font/jua"
        android:textStyle="bold"
        android:layout_marginStart="50dp"
        android:layout_marginTop="04dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloBalanceHome"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnContenedorEnviarDineroHomePage"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="33dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:onClick="irASendMoney"
        android:background="@drawable/bg_boton_verde_enviar_dinero_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBackground">

        <ImageView
            android:id="@+id/ivFlechaBotonEnviar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_flecha_send"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/txtEnviarDineroHome"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtEnviarDineroHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/jua"
            android:text="Enviar Dinero"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivFlechaBotonEnviar"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnContenedorIngresarDineroHomePage"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="33dp"
        android:onClick="irARequestMoney"
        android:background="@drawable/bg_boton_azul_ingresar_dinero_home"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBackground">

        <ImageView
            android:id="@+id/ivFlechaBotonIngresar"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_ingresar_dinero"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/txtIngresarDineroHome"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.589" />

        <TextView
            android:id="@+id/txtIngresarDineroHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/jua"
            android:text="Ingresar Dinero"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivFlechaBotonIngresar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.515" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="160dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_notifications" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/headerBackground">

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="67dp"
            android:layout_height="54dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_foto_perfil" />

        <ImageView
            android:id="@+id/imgLapizEditar"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:onClick="irAPerfil"
            android:elevation="4dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@android:drawable/ic_menu_edit" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtUltimasTransaccionesHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/jua"
        android:text="Últimas transacciones"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnContenedorEnviarDineroHomePage" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorFragmentLista"
        android:name="com.example.alkewallet.ListaTransaccionesFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtUltimasTransaccionesHome"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout="@layout/fragment_lista_transacciones"/>

</androidx.constraintlayout.widget.ConstraintLayout>